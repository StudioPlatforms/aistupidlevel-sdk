{
  "name": "previewRoute",
  "typeId": 4,
  "label": "Preview a Route",
  "description": "Shows which model the Smart Router would pick for a conversation, with its score, estimated cost and fallbacks. Nothing is sent to a model or counted.",
  "api": {
    "url": "/route/preview",
    "method": "POST",
    "body": {
      "model": "{{parameters.model}}",
      "messages": "{{parameters.messages}}"
    },
    "type": "json",
    "response": {
      "output": {
        "routing_mode": "{{body.requested_model}}",
        "strategy": "{{body.strategy}}",
        "model": "{{body.primary.model}}",
        "provider": "{{body.primary.provider}}",
        "score": "{{body.primary.score}}",
        "why": "{{body.primary.reasoning}}",
        "estimated_cost_usd": "{{body.primary.estimated_cost_usd}}",
        "fallbacks": "{{map(body.fallbacks; 'model')}}",
        "fallback_enabled": "{{body.fallback_enabled}}"
      }
    }
  },
  "parameters": [],
  "expect": [
    {
      "name": "model",
      "label": "Routing mode",
      "type": "select",
      "required": true,
      "default": "auto-best",
      "options": "rpc://routingModes",
      "help": "Each request goes to the model that scores best for this mode on AI Stupid Level's benchmarks, among the providers you connected. Choose a model ID to pin that model."
    },
    {
      "name": "messages",
      "label": "Messages",
      "type": "array",
      "required": true,
      "spec": [
        {
          "name": "role",
          "label": "Role",
          "type": "select",
          "required": true,
          "default": "user",
          "options": [
            {
              "label": "User",
              "value": "user"
            },
            {
              "label": "System (instructions)",
              "value": "system"
            },
            {
              "label": "Assistant",
              "value": "assistant"
            }
          ]
        },
        {
          "name": "content",
          "label": "Content",
          "type": "text",
          "required": true
        }
      ],
      "help": "The conversation. Put instructions in a System message and the prompt in a User message."
    }
  ],
  "interface": [
    {
      "name": "model",
      "label": "Model it would pick",
      "type": "text"
    },
    {
      "name": "provider",
      "label": "Provider",
      "type": "text"
    },
    {
      "name": "score",
      "label": "Score",
      "type": "number"
    },
    {
      "name": "why",
      "label": "Why this model",
      "type": "text"
    },
    {
      "name": "estimated_cost_usd",
      "label": "Estimated cost (USD)",
      "type": "number"
    },
    {
      "name": "fallbacks",
      "label": "Fallback models",
      "type": "array",
      "spec": {
        "type": "text"
      }
    },
    {
      "name": "routing_mode",
      "label": "Routing mode",
      "type": "text"
    },
    {
      "name": "strategy",
      "label": "Strategy",
      "type": "text"
    },
    {
      "name": "fallback_enabled",
      "label": "Fallback enabled",
      "type": "boolean"
    }
  ],
  "samples": {
    "model": "claude-opus-5-5",
    "provider": "anthropic",
    "score": 99,
    "why": "Selected claude-opus-5-5 from anthropic for best coding performance. Ranked #1 of 24 available models.",
    "estimated_cost_usd": 0.012,
    "fallbacks": [
      "deepseek-v4-flash",
      "gpt-5.6-luna"
    ],
    "routing_mode": "auto-coding",
    "strategy": "best_coding",
    "fallback_enabled": true
  }
}
