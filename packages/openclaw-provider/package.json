{
  "name": "@aistupidlevel/openclaw-provider",
  "version": "0.1.0",
  "description": "OpenClaw provider plugin for the AI Stupid Level Smart Router: each request goes to the model scoring best right now on continuously re-run benchmarks, with your own provider keys.",
  "type": "module",
  "license": "MIT",
  "author": "AI Stupid Level <hello@aistupidlevel.info> (https://aistupidlevel.info)",
  "homepage": "https://github.com/StudioPlatforms/aistupidlevel-sdk/tree/main/packages/openclaw-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StudioPlatforms/aistupidlevel-sdk.git",
    "directory": "packages/openclaw-provider"
  },
  "bugs": "https://github.com/StudioPlatforms/aistupidlevel-sdk/issues",
  "keywords": ["openclaw", "openclaw-plugin", "llm", "router", "openai-compatible", "aistupidlevel"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/index.js", "dist/index.d.ts", "openclaw.plugin.json", "assets", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "devDependencies": {
    "openclaw": "2026.10.5",
    "typescript": "5.9.3"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "providers": ["aistupidlevel"],
    "compat": {
      "pluginApi": ">=2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    }
  }
}
